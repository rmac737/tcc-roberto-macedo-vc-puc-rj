## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Rider
.idea/

# VS Code
.vscode/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Publish
publish/

# Azure
PublishScripts/

# Entity Framework
*.edmx.diagram

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# DotCover
*.dotCover

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# JetBrains Rider
*.sln.iml

# dotenv
.env
.env.*

# Coverage
coverage/
*.coverage
*.coveragexml

# Docker
docker-compose.override.yml

# Generated files
Generated_Code/

# SQLite
*.db
*.sqlite

# Backup files
*.bak
*.backup

# Secrets
secrets.json
appsettings.Development.json

# Ignore node modules (if frontend exists)
node_modules/

# Ignore frontend build
dist/
build/

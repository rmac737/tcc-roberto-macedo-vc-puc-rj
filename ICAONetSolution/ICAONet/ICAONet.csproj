    <None Remove="FaceDetection\res10_300x300_ssd_iter_140000.caffemodel" />
    <None Remove="FaceMatch\glintr100.onnx" />
    <None Remove="GazeEstimation\resnet34_gaze.onnx" />
    <None Remove="GlassDetection\glass_no_glass.onnx" />
    <None Remove="HeadCoverDetection\head_cover.onnx" />
    <None Remove="HeadPose\sixdrepnet.onnx" />
    <None Remove="ImageQuality\focused_no_focused.onnx" />
    <None Remove="ImageQuality\pixeled_no_pixeled.onnx" />
